    type: 'dir',
    entries: ['home']
  },
  '/home': {
    type: 'dir',
    entries: ['analyst']
  },
  '/home/analyst': {
    type: 'dir',
    entries: ['workspace', 'notes.txt', 'logs']
  },
  '/home/analyst/workspace': {

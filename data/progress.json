function ensureDataFiles() {
  if (!fs.existsSync(DATA_DIR)) fs.mkdirSync(DATA_DIR, { recursive: true });
  if (!fs.existsSync(PROGRESS_FILE)) {
    fs.writeFileSync(PROGRESS_FILE, JSON.stringify(DEFAULT_PROGRESS, null, 2));
  }
}

function loadProgress() {
  ensureDataFiles();
  const raw = fs.readFileSync(PROGRESS_FILE, 'utf8');
  try {
    return JSON.parse(raw);
  } catch (error) {
    return DEFAULT_PROGRESS;
  }
}

function saveProgress(progress) {
  ensureDataFiles();
  fs.writeFileSync(PROGRESS_FILE, JSON.stringify(progress, null, 2));
}

function buildSkillMap(progress) {
  const skills = progress.demoUser?.skills || DEFAULT_PROGRESS.demoUser.skills;
  return {
    networking: { introduced: skills.networking.introduced || true, practiced: skills.networking.practiced || false, mastered: skills.networking.mastered || false },
    linux: { introduced: skills.linux.introduced || true, practiced: skills.linux.practiced || false, mastered: skills.linux.mastered || false },
    webSecurity: { introduced: skills.webSecurity.introduced || true, practiced: skills.webSecurity.practiced || false, mastered: skills.webSecurity.mastered || false },
    auth: { introduced: skills.auth.introduced || true, practiced: skills.auth.practiced || false, mastered: skills.auth.mastered || false },
    secureCoding: { introduced: skills.secureCoding.introduced || true, practiced: skills.secureCoding.practiced || false, mastered: skills.secureCoding.mastered || false },
    logAnalysis: { introduced: skills.logAnalysis.introduced || true, practiced: skills.logAnalysis.practiced || false, mastered: skills.logAnalysis.mastered || false },
    incidentResponse: { introduced: skills.incidentResponse.introduced || true, practiced: skills.incidentResponse.practiced || false, mastered: skills.incidentResponse.mastered || false }
  };
}


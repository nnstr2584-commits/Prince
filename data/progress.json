  }
};

const ALLOWED_COMMANDS = new Set(['help', 'pwd', 'ls', 'cd', 'cat', 'whoami', 'clear']);

function terminalState() {
  return {
    currentDir: '/home/analyst',
    user: 'analyst'
  };
}

function resolvePath(currentDir, target) {
  if (!target || target === '.') return currentDir;
  if (target === '/') return '/';
  if (target.startsWith('/')) return target;
  const normalized = `${currentDir.replace(/\/$/, '')}/${target}`;
  return normalized.replace(/\/+/g, '/').replace(/\/$/, '') || '/';
}

function terminalExecute(input) {
  const trimmed = String(input || '').trim();
  if (!trimmed) {
    return { ok: false, output: ['No command entered. Type "help" for a list of supported commands.'] };
  }

  const parts = trimmed.split(/\s+/);
  const command = parts[0].toLowerCase();
  const args = parts.slice(1);
  const state = terminalState();

  if (!ALLOWED_COMMANDS.has(command)) {
    return {
      ok: false,
      output: [
        `Unknown command: ${command}`,
        'This lab uses a controlled allowlist. Try: help, pwd, ls, cd, cat, whoami, clear.'
      ]
    };
  }

  switch (command) {
    case 'help':
      return {
        ok: true,
        output: [
          'Available commands:',
          '  help      Show this help menu',
          '  pwd       Print the current working directory',
          '  ls        List files and directories',
          '  cd        Change directory',
          '  cat       View file contents',
          '  whoami   Show the active user',
          '  clear     Clear the terminal screen'
        ]
      };
    case 'pwd':
      return { ok: true, output: [state.currentDir] };
    case 'whoami':
      return { ok: true, output: [state.user] };
    case 'ls': {
      const target = args[0] ? resolvePath(state.currentDir, args[0]) : state.currentDir;
      const node = FILESYSTEM[target];
      if (!node || node.type !== 'dir') {
        return { ok: false, output: [`ls: cannot access '${target}': No such file or directory`] };
      }
      return { ok: true, output: node.entries.map(name => name) };
    }
    case 'cd': {
      if (!args[0]) return { ok: true, output: [state.currentDir] };
      const target = resolvePath(state.currentDir, args[0]);
      const node = FILESYSTEM[target];
      if (!node || node.type !== 'dir') {
        return { ok: false, output: [`cd: ${args[0]}: No such file or directory`] };
      }
      state.currentDir = target;
      return { ok: true, output: [] };
    }
    case 'cat': {
      if (!args[0]) return { ok: false, output: ['cat: missing file operand'] };
      const target = resolvePath(state.currentDir, args[0]);
      const node = FILESYSTEM[target];
      if (!node || node.type !== 'file') {
        return { ok: false, output: [`cat: ${args[0]}: No such file or directory`] };
      }
      return { ok: true, output: [node.content] };
    }
    case 'clear':
      return { ok: true, output: ['\u001b[2J\u001b[H'] };
    default:
      return { ok: false, output: ['Unsupported command in the lab. Use the allowlist shown by "help".'] };
  }
}

function validateChallengeSubmission(challengeId, payload = {}) {
  const challenge = CHALLENGES.find((item) => item.id === challengeId);
  if (!challenge) return { valid: false, message: 'Challenge not found.' };

  switch (challenge.id) {
    case 'linux-terminal-pwd': {
      const value = String(payload.answer || payload.value || '').trim();
      const ok = value.includes('/home/analyst') || value.includes('/home/analyst/workspace');
      return ok
        ? { valid: true, points: challenge.points, message: 'Correct. The current directory is in the analyst home area.' }
        : { valid: false, points: 0, message: 'Try the pwd command in the terminal simulator.' };
    }
    case 'web-security-xss': {
      const text = String(payload.answer || payload.value || '').toLowerCase();
      const hasMitigation = ['sanitize', 'escape', 'encode', 'validate', 'context'].some((token) => text.includes(token));
      return hasMitigation
        ? { valid: true, points: challenge.points, message: 'Correct. Unsafe input should be encoded or escaped before rendering.' }
        : { valid: false, points: 0, message: 'Explain the risk and name a mitigation such as escaping or encoding.' };
    }
    case 'blue-team-incident': {
      const ipOk = String(payload.ip || '').includes('198.51.100.18');
      const severityOk = String(payload.severity || '').toLowerCase() === 'high';
      const indicatorOk = String(payload.finding || '').toLowerCase().includes('repeated failed logins');
      return ipOk && severityOk && indicatorOk
        ? { valid: true, points: challenge.points, message: 'Confirmed. Repeated failed logins from 198.51.100.18 indicate a high-severity brute-force pattern.' }
        : { valid: false, points: 0, message: 'Review the auth.log entries and classify the activity as a repeated failed-login attempt from the suspicious IP.' };
    }
    case 'network-http': {
      const method = String(payload.method || '').toUpperCase();
      const status = Number(payload.status || payload.statusCode || 0);
      const protocol = String(payload.protocol || '').toUpperCase();
      return method === 'GET' && status === 200 && protocol === 'HTTP/1.1'
        ? { valid: true, points: challenge.points, message: 'Correct. The request was a GET to / and the server responded with HTTP/1.1 200 OK.' }
        : { valid: false, points: 0, message: 'Check the sample HTTP exchange: method GET, status 200, protocol HTTP/1.1.' };
    }
    default:
      return { valid: false, message: 'Validation not configured for this challenge.' };
  }
}

app.get('/api/health', (_req, res) => {
  res.json({ ok: true, mode: 'demo', timestamp: new Date().toISOString() });
});

app.get('/api/labs', (_req, res) => {
  res.json({ labs: LAB_CATALOG });
});

app.get('/api/challenges', (_req, res) => {
  res.json({ challenges: CHALLENGES });
});

app.get('/api/progress', (_req, res) => {
  const progress = loadProgress();
  res.json({ user: progress.demoUser, skillMap: buildSkillMap(progress) });
});

app.get('/api/skill-map', (_req, res) => {
  const progress = loadProgress();
  res.json({ skillMap: buildSkillMap(progress) });
});

app.post('/api/terminal', (req, res) => {
  const { command } = req.body || {};
  const result = terminalExecute(command);
  res.json(result);
});

app.post('/api/challenges/validate', (req, res) => {
  const { challengeId, ...payload } = req.body || {};
  const result = validateChallengeSubmission(challengeId, payload);
  if (result.valid) {
    const progress = loadProgress();
    const userProgress = progress.demoUser;
    userProgress.challenges = userProgress.challenges || [];
    if (!userProgress.challenges.includes(challengeId)) {
      userProgress.challenges.push(challengeId);
    }

    if (challengeId === 'linux-terminal-pwd') userProgress.skills.linux.practiced = true;
    if (challengeId === 'web-security-xss') userProgress.skills.webSecurity.practiced = true;
    if (challengeId === 'blue-team-incident') userProgress.skills.logAnalysis.practiced = true;
    if (challengeId === 'network-http') userProgress.skills.networking.practiced = true;

    const allCompleted = CHALLENGES.every((challenge) => userProgress.challenges.includes(challenge.id));
    if (allCompleted) {
      Object.keys(userProgress.skills).forEach((skill) => { userProgress.skills[skill].mastered = true; });
    }

    saveProgress(progress);
  }
  res.json(result);
});

app.post('/api/blue-team/investigate', (req, res) => {
  const { ip, severity, finding } = req.body || {};
  const response = validateChallengeSubmission('blue-team-incident', { ip, severity, finding });
  res.json(response);
});

app.get('*', (_req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

if (require.main === module) {
  app.listen(PORT, () => {
    console.log(`Question & Hacking Cyber Lab is running on http://localhost:${PORT}`);
  });
}

module.exports = { app, LAB_CATALOG, CHALLENGES, validateChallengeSubmission, terminalExecute, buildSkillMap };
